# Public site URL (used for metadata / JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Strapi backend — GraphQL is served at $STRAPI_URL/graphql. Leave empty to use the mock catalogue.
STRAPI_URL=http://localhost:1337
# Optional read-only Strapi API token (Settings → API Tokens) — not required with the default public permissions.
STRAPI_API_TOKEN=
# Shared secret for Strapi's revalidation webhook (same value as REVALIDATE_SECRET in the backend's .env)
REVALIDATE_SECRET=
